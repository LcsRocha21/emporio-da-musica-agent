# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your-api-key-here

# Optional: which Gemini model to use (default: gemini-3.5-flash).
# gemini-3.5-flash-lite is cheaper and has looser free-tier limits, but it is more likely to
# add details that the tools did not state.
# Run `python -m emporio_agent.llm_check --list-models` to see the ones your key can use.
# GEMINI_MODEL=gemini-3.5-flash

# Optional: pretend "now" is a specific moment (store timezone, ISO 8601).
# Useful because the sample orders are dated 2025 - March 2026, so return windows
# and opening hours can be tested reproducibly. Leave unset to use the real clock.
# EMPORIO_NOW=2026-02-20T10:30:00
