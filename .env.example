# Copy this file to .env and fill in your own values. Never commit .env.
GEMINI_API_KEY=your-api-key-here

# Optional: pretend "now" is a specific moment (store timezone, ISO 8601).
# Useful because the sample orders are dated 2025 - March 2026, so return windows
# and opening hours can be tested reproducibly. Leave unset to use the real clock.
# EMPORIO_NOW=2026-02-20T10:30:00
